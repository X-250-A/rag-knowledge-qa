# ============================================================
# 环境变量模板 —— 复制为 .env 后填写
# 必填项缺失 / 为空 / 仍为占位符，应用会在启动时被 config 校验拦截
# ============================================================

# ===== 必填（填真实值，否则启动失败）=====
# DeepSeek API 密钥
DEEPSEEK_API_KEY="change-me-to-your-key"
# JWT 签名密钥（改成足够随机、够长的字符串）
SECRET_KEY="change-me-to-your-key"

# ===== 数据库 =====
# 本地默认用 sqlite；如需其他库改成对应异步驱动，如 postgresql+asyncpg://...
DATABASE_URL="sqlite+aiosqlite:///./rag_qa.db"

# ===== LLM（DeepSeek，OpenAI 兼容接口）=====
BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# ===== JWT =====
ACCESS_TOKEN_EXPIRE_MINUTES=86400
ALGORITHMS=["HS256"]

# ===== LLM 超时（秒）=====
LLM_CONNECTION_TIMEOUT=10.0
LLM_READ_TIMEOUT=45.0
LLM_REQUEST_TIMEOUT=90.0

# ===== 日志 =====
LOG_LEVEL="INFO"
